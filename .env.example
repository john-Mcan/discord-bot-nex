DISCORD_TOKEN=
DISCORD_CLIENT_ID=
RADIO_STREAM_URL=https://example.com/radio.mp3

# Opcionales
DEV_GUILD_ID=
RADIO_NAME=Mi Radio
IDLE_DISCONNECT_MINUTES=5
COMMAND_COOLDOWN_SECONDS=3

# Metadata JSON alternativa/fallback
RADIO_METADATA_URL=https://api.nex-radio.com/api/radio/snapshot
RADIO_METADATA_TITLE_PATH=now_playing.song.title
RADIO_METADATA_ARTIST_PATH=now_playing.song.artist
RADIO_METADATA_ARTWORK_PATH=now_playing.song.cover_url
METADATA_POLL_SECONDS=15

# Healthcheck local. Usa HEALTH_PORT=0 para deshabilitarlo.
HEALTH_HOST=127.0.0.1
HEALTH_PORT=3000
