{
  "name": "discord-bot-nex",
  "version": "0.1.0",
  "private": true,
  "description": "Discord radio/music bot",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
