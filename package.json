{
  "name": "discord-bot-nex",
  "version": "0.1.0",
  "private": true,
  "description": "Discord radio/music bot",
  "license": "MIT",
  "author": "John Moya C.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/john-Mcan/discord-bot-nex.git"
  },
  "homepage": "https://github.com/john-Mcan/discord-bot-nex#readme",
  "bugs": {
    "url": "https://github.com/john-Mcan/discord-bot-nex/issues"
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "deploy:commands": "tsx src/deploy-commands.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
